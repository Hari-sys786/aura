# Aura Configuration
# Copy to .env and fill in your values

# AI Provider: ollama | openai | anthropic | nvidia | groq | custom
AI_PROVIDER=ollama
AI_MODEL=llama3.2
AI_BASE_URL=http://localhost:11434
AI_API_KEY=

# Storage
DATA_DIR=./data
SQLITE_PATH=./data/aura.db

# Encryption (set a master password for data-at-rest encryption)
MASTER_PASSWORD=

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=

# Google Calendar (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
